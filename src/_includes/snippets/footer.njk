<button id="back-to-top" class="inline-flex items-center justify-center rounded bg-moss px-1 py-1 font-semibold text-bone hover:bg-peat" style="display: none; position: fixed; bottom: 20px; right: 20px;" data-toggle="tooltip" data-placement="left" title="Back to the top"><i class="fa-solid fa-circle-up" style="color: white;"></i></button>

<!-- Custom JS (vanilla interaction shim) -->
<script src="/js/back-to-top.js" integrity="sha384-8kgCB6HPdPPbW6F14pulqulPbhSUEbJzrm4fbq6BHSQV2hwUSs0mzrVfKLTw43rw"></script>

  <section class="">
    <div class="mx-auto w-full max-w-6xl px-4 text-center lg:text-left mt-5">
      <!-- Grid row -->
      <div class="grid grid-cols-12 mt-3">
        <!-- Grid column -->
        <div class="md:col-span-3 lg:col-span-4 xl:col-span-3 mx-auto mb-4">
          <!-- Content -->
          <h6 class="uppercase font-bold mb-4">
            {{ metadata.title }}
          </h6>
          <p>
            Copyright © 2019-{{ site.currentYear }}, {{ metadata.title }}. {{ metadata.description }} <a href="/license">[Celtic Culture Attribution-ShareAlike 1.0 International Public License]</a>.
          </p>
        </div>

        <!-- Grid column -->
        <div class="md:col-span-2 lg:col-span-2 xl:col-span-2 mx-auto mb-4">
          <!-- Links -->
          <h6 class="uppercase font-bold mb-4">
            Quick Links
          </h6>
          <p>
            <a href="/about" class="text-bone hover:opacity-80">About Project</a>
          </p>
          <p>
            <a href="/support" class="text-bone hover:opacity-80">Support Us</a>
          </p>
          <p>
            <a href="/docs" class="text-bone hover:opacity-80">Documentation</a>
          </p>
          <p>
            <a href="/docs/contributing/conduct" class="text-bone hover:opacity-80">Code of Conduct</a>
          </p>
          <p>
            <a href="/license" class="text-bone hover:opacity-80">Open Source Licenses</a>
          </p>
          <p>
            <a href="/FAQs" class="text-bone hover:opacity-80">Frequently Asked Questions</a>
          </p>
        </div>

        <!-- Grid column -->
        <div class="md:col-span-3 lg:col-span-2 xl:col-span-2 mx-auto mb-4">
          <!-- Links -->
          <h6 class="uppercase font-bold mb-4">
            Social Media
          </h6>
          <p>
            <a href="http://github.com/openordu" target="_blank" class="text-bone hover:opacity-80">GitHub</a>
          </p>
          <p>
            <a href="#!" class="text-bone hover:opacity-80">Twitter</a>
          </p>
          <p>
            <a href="https://mastodon.celticpaganism.org" target="_blank" class="text-bone hover:opacity-80">Mastodon</a>
          </p>
        </div>

        <!-- Grid column -->
        <div class="md:col-span-4 lg:col-span-3 xl:col-span-3 mx-auto mb-4">
          <!-- Links -->
          <h6 class="uppercase font-bold mb-4">
            Contact
          </h6>
          <p><i class="fas fa-envelope mr-3"></i><a class="email-encode" href="mailto:{{ metadata.email }}">{{ metadata.email }}</a></p>

          <h6 class="uppercase font-bold mb-4 mt-4">
            Disclaimer
          </h6>
          <p>
            This project and its contributors are not responsible for any misuse of the software. This project is provided as is and without any warranty.
          </p>
        </div>
      </div>
    </div>
  </section>
  <div class="text-center p-4 bg-moss text-peat">
    Made with ❤️ by contributors around the world
  </div>
