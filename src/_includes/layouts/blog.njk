<!doctype html>
<html class="h-full" lang="{{ metadata.language }}">

  <head>
    {% include 'snippets/head.njk' %}
  </head>

  <body>

    {% include 'snippets/navbar.njk' %}

    <main class="mx-auto w-full max-w-6xl px-4">
      <div class="grid grid-cols-12 justify-center">
        <div class="col-span-12 xl:col-span-8">
          <div class="py-vh-6 px-5 text-center">
          {% include 'snippets/maincontent.njk' %}
        </div>
      </div>
      </div>
    </main>

    <div class="mx-auto w-full max-w-6xl px-4 py-vh-4 pt-0">
      <div class="grid grid-cols-12 justify-between">
        <div class="col-span-12 md:col-span-7 border-t">
          {% include 'snippets/postloop.njk' %}
        </div>
        <div class="col-span-12 md:col-span-4 border-t p-0 pt-5 pb-5">
          {% include 'snippets/blogsidebar.njk' %}
        </div>
      </div>
    </div>

    <footer class="text-center lg:text-left bg-peat/60 text-mist pt-1">
      {% include 'snippets/footer.njk' %}
    </footer>

  </body>

</html>